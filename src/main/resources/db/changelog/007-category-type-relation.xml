    <!-- ==================== ADD CATEGORY_ID TO TICKET ==================== -->
    <changeSet id="024-add-category-id-to-ticket" author="liquibase">
        <addColumn tableName="ticket">
            <column name="category_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

    <!-- ==================== MIGRATE EXISTING CATEGORY VALUES ==================== -->
    <changeSet id="025-migrate-category-to-category-id" author="liquibase">
        <sql>UPDATE ticket t SET category_id = (SELECT c.id FROM category c WHERE LOWER(c.name) = LOWER(t.category)) WHERE t.category IS NOT NULL AND EXISTS (SELECT 1 FROM category WHERE LOWER(name) = LOWER(t.category))</sql>
        <sql>UPDATE ticket SET category_id = (SELECT id FROM category WHERE name = 'autres') WHERE category_id IS NULL</sql>
    </changeSet>

    <!-- ==================== FK CONSTRAINT FOR TICKET CATEGORY ==================== -->
    <changeSet id="026-add-ticket-category-fk" author="liquibase">
        <addForeignKeyConstraint
                baseTableName="ticket"
                baseColumnNames="category_id"
                constraintName="fk_ticket_category"
                referencedTableName="category"
                referencedColumnNames="id"/>
    </changeSet>

    <!-- ==================== INDEXES FOR CATEGORY AND CATEGORY_ISSUE_TYPE ==================== -->
    <changeSet id="027-create-category-indexes" author="liquibase">
        <createIndex indexName="idx_category_active" tableName="category">
            <column name="active"/>
        </createIndex>
        <createIndex indexName="idx_ticket_category_id" tableName="ticket">
            <column name="category_id"/>
        </createIndex>
        <createIndex indexName="idx_category_issue_type_category" tableName="category_issue_type">
            <column name="category_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>